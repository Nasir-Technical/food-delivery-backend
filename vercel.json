{
  "version": 2,

  "functions": {
    "api/server.js": {
      "runtime": "@vercel/node",
      "maxDuration": 10
    }
  },

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.js"
    },

    {
      "src": "/admin/(.*)",
      "dest": "/admdist/$1"
    },
    {
      "src": "/admin",
      "dest": "/admdist/index.html"
    },

    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/dist/$1"
    },

    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ]
}
