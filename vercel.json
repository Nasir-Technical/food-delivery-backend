{
  "version": 2,
  "builds": [
    {
      "src": "server.js",      
      "use": "@vercel/node"
    },
    {
      "src": "admdist/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin/.*",
      "dest": "/admdist/index.html"
    },
    {
      "src": "/api/.*",
      "dest": "server.js"      
    },
    {
      "src": "/.*",
      "dest": "index.html"
    }
  ]
}