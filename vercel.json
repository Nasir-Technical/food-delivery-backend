{
  "version": 2,
  "functions": {
    "api/server.js": {
      "runtime": "nodejs18",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/server.js" },

    
    { "src": "/admin/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot))", "dest": "/admdist/$1" },
    { "src": "/admin", "dest": "/admdist/index.html" },

    
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot))", "dest": "/dist/$1" },

    
    { "src": "/admin/(.*)", "dest": "/admdist/index.html" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ]
}
